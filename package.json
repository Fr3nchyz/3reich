{
  "name": "3reich",
  "version": "0.1.0",
  "private": true,
  "description": "A playable recreation of the classic WWII grand-strategy wargame Third Reich, for the browser.",
  "type": "module",
  "engines": {
    "node": "^20.19 || ^22.13 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.engine.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "coverage": "vitest run --coverage",
    "e2e": "npm run build && playwright test",
    "selfplay": "vite-node scripts/selfplay/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
