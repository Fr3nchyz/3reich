{
  "name": "3reich",
  "version": "0.1.0",
  "private": true,
  "description": "A playable recreation of the classic WWII grand-strategy wargame Third Reich, for the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.engine.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
